{
  "env_file": "/config/.env.runtime",
  "service": {
    "mode": "serve",
    "host": "0.0.0.0",
    "port": 8000,
    "workers": 1,
    "mount_work_root": "/work",
    "mount_config_root": "/config",
    "mount_artifacts_root": "/artifacts",
    "queue_backend": "inmemory",
    "network_policy": "inherit"
  },
  "run": {
    "command_profile": "playground-python",
    "command_profiles_path": "/opt/lllars/docker/runtime.command-profiles.yaml"
  }
}
