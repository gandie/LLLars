{
  "service": {
    "mode": "oneshot",
    "host": "127.0.0.1",
    "port": 8000,
    "workers": 1,
    "mount_work_root": "playground",
    "mount_config_root": ".",
    "mount_artifacts_root": ".",
    "queue_backend": "inmemory",
    "network_policy": "inherit"
  },
  "run": {
    "model": "ollama:gemma4:latest",
    "provider_url": "http://localhost:11434",
    "project_root": "playground",
    "commands": {},
    "command_profile": "playground-python",
    "command_profiles_path": "playground.command-profiles.yaml",
    "tool_groups": {
      "enabled": [
        "mcp_toolsets"
      ],
      "disabled": []
    },
    "web_research": {
      "domain_policy": "none",
      "allowed_domains": [],
      "blocked_domains": [],
      "local_fallback": true
    },
    "tool_plugins": {
      "paths": [
      ]
    },
    "eval_expect_json": false,
    "eval_success_pass_rate": 100.0,
    "usage_request_limit": null,
    "usage_tool_calls_limit": null,
    "usage_input_tokens_limit": null,
    "usage_output_tokens_limit": null,
    "usage_total_tokens_limit": null,
    "usage_count_tokens_before_request": false,
    "agent_retries_tools": null,
    "agent_retries_output": null,
    "tool_timeout_sec": 90,
    "max_concurrency": null,
    "instrumentation_enabled": false,
    "instrumentation_include_content": false,
    "skills_enabled": true,
    "skills_glob": "skills/factorio_agent.md",
    "skills_defer_loading": false,
    "skills_require_description": true,
    "mcp_enabled": true,
    "mcp_config_path": "factorio_mcp.servers.json",
    "mcp_init_timeout_sec": 60,
    "todo_capability_enabled": true,
    "system_prompt": "You are a factorio bot. Play the game with the tools you have.",
    "tool_policy": "Use skills to find guidance on how to play factorio."
  }
}