FROM python:3.11-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

WORKDIR /opt/lllars

COPY pyproject.toml README.md lllars.py playground.example.json ./
COPY lllars_core ./lllars_core
COPY playground ./playground
COPY mcp.servers.json ./mcp.servers.json
COPY docker/runtime-entrypoint.sh /usr/local/bin/runtime-entrypoint.sh

RUN pip install --no-cache-dir . \
    && chmod +x /usr/local/bin/runtime-entrypoint.sh \
    && mkdir -p /config /work /artifacts /opt/lllars/defaults/config /opt/lllars/defaults/work \
    && cp /opt/lllars/playground.example.json /opt/lllars/defaults/config/playground.example.json \
    && cp -R /opt/lllars/playground/. /opt/lllars/defaults/work/

ENTRYPOINT ["/usr/local/bin/runtime-entrypoint.sh"]
