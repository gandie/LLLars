FROM python:3.11-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

WORKDIR /opt/lllars

COPY . .

RUN pip install --no-cache-dir . \
    && chmod +x /opt/lllars/docker/runtime-entrypoint.sh \
    && mkdir -p /config /work /artifacts /opt/lllars/defaults/config /opt/lllars/defaults/work \
    && cp /opt/lllars/docker/runtime.container.json /opt/lllars/defaults/config/ \
    && cp /opt/lllars/.env.runtime.example /opt/lllars/defaults/config/ \
    && cp -R /opt/lllars/playground/. /opt/lllars/defaults/work/

ENTRYPOINT ["/opt/lllars/docker/runtime-entrypoint.sh"]
